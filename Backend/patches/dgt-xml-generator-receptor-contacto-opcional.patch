diff --git a/src/Builders/BaseDocumentBuilder.php b/src/Builders/BaseDocumentBuilder.php
index 5dee30a10..3bbcea352 100644
--- a/src/Builders/BaseDocumentBuilder.php
+++ b/src/Builders/BaseDocumentBuilder.php
@@ -181,14 +181,17 @@ abstract class BaseDocumentBuilder
         // Activity
         $issuer->setActivity($issuerData['activity']);
 
-        // Location
-        $issuer->setLocation($issuerData['location']);
+        if (! empty($issuerData['location'])) {
+            $issuer->setLocation($issuerData['location']);
+        }
 
-        // Phone
-        $issuer->setPhone($issuerData['phone']);
+        if (! empty($issuerData['phone'])) {
+            $issuer->setPhone($issuerData['phone']);
+        }
 
-        // Email
-        $issuer->setEmail($issuerData['email']);
+        if (! empty($issuerData['email'])) {
+            $issuer->setEmail($issuerData['email']);
+        }
 
         $this->document->setIssuer($issuer);
     }
@@ -216,14 +219,18 @@ abstract class BaseDocumentBuilder
             $receiver->setActivity($receiverData['activity']);
         }
 
-        // Location
-        $receiver->setLocation($receiverData['location']);
+        // Location, phone and email are optional on the receiver (XSD). Omit when the client has no data.
+        if (! empty($receiverData['location'])) {
+            $receiver->setLocation($receiverData['location']);
+        }
 
-        // Phone
-        $receiver->setPhone($receiverData['phone']);
+        if (! empty($receiverData['phone'])) {
+            $receiver->setPhone($receiverData['phone']);
+        }
 
-        // Email
-        $receiver->setEmail($receiverData['email']);
+        if (! empty($receiverData['email'])) {
+            $receiver->setEmail($receiverData['email']);
+        }
 
         $this->document->setReceiver($receiver);
     }
