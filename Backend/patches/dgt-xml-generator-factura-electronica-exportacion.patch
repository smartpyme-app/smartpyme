--- /dev/null
+++ b/src/Models/ExportInvoice/ExportInvoice.php
@@ -0,0 +1,28 @@
+<?php
+
+namespace DazzaDev\DgtXmlGenerator\Models\ExportInvoice;
+
+use DazzaDev\DgtXmlGenerator\Models\Document;
+
+/**
+ * Factura electrónica de exportación (09).
+ */
+class ExportInvoice extends Document
+{
+    /**
+     * ExportInvoice constructor
+     */
+    public function __construct(array $data = [])
+    {
+        $this->setDocumentType('09');
+
+        if (empty($data)) {
+            parent::__construct($data);
+        }
+    }
+
+    public function toArray(): array
+    {
+        return parent::toArray();
+    }
+}
