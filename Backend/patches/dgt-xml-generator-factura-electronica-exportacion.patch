diff --git a/src/Builders/ExportInvoiceBuilder.php b/src/Builders/ExportInvoiceBuilder.php
new file mode 100644
index 000000000..54a0a1528
--- /dev/null
+++ b/src/Builders/ExportInvoiceBuilder.php
@@ -0,0 +1,37 @@
+<?php
+
+namespace DazzaDev\DgtXmlGenerator\Builders;
+
+use DazzaDev\DgtXmlGenerator\Models\ExportInvoice\ExportInvoice;
+use LogicException;
+
+class ExportInvoiceBuilder extends BaseDocumentBuilder
+{
+    /**
+     * Create document instance
+     */
+    protected function createDocument(): ExportInvoice
+    {
+        return new ExportInvoice($this->documentData);
+    }
+
+    /**
+     * Get document type for XML generation (Twig view name without .xml.twig)
+     */
+    protected function getDocumentType(): string
+    {
+        return 'export-invoice';
+    }
+
+    /**
+     * @return ExportInvoice
+     */
+    public function getExportInvoice(): ExportInvoice
+    {
+        if (! $this->document instanceof ExportInvoice) {
+            throw new LogicException('Expected ExportInvoice document.');
+        }
+
+        return $this->document;
+    }
+}
