diff --git a/src/Builders/PaymentReceiptBuilder.php b/src/Builders/PaymentReceiptBuilder.php
new file mode 100644
index 000000000..b2c3d4e5f
--- /dev/null
+++ b/src/Builders/PaymentReceiptBuilder.php
@@ -0,0 +1,28 @@
+<?php
+
+namespace DazzaDev\DgtXmlGenerator\Builders;
+
+use DazzaDev\DgtXmlGenerator\Models\PaymentReceipt\PaymentReceipt;
+use LogicException;
+
+class PaymentReceiptBuilder extends BaseDocumentBuilder
+{
+    protected function createDocument(): PaymentReceipt
+    {
+        return new PaymentReceipt($this->documentData);
+    }
+
+    protected function getDocumentType(): string
+    {
+        return 'payment-receipt';
+    }
+
+    public function getPaymentReceipt(): PaymentReceipt
+    {
+        if (! $this->document instanceof PaymentReceipt) {
+            throw new LogicException('Expected PaymentReceipt document.');
+        }
+
+        return $this->document;
+    }
+}
