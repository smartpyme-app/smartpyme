diff --git a/src/Views/Components/line-item-payment-receipt.xml.twig b/src/Views/Components/line-item-payment-receipt.xml.twig
new file mode 100644
index 000000000..l10repline
--- /dev/null
+++ b/src/Views/Components/line-item-payment-receipt.xml.twig
@@ -0,0 +1,13 @@
+{# XSD reciboElectronicoPago v4.4: sin CABYS/Cantidad/Unidad/PrecioUnitario/BaseImponible (condición 4). Orden: NumeroLinea → Detalle → MontoTotal → SubTotal → [Impuesto] → ImpuestoNeto → MontoTotalLinea. #}
+<LineaDetalle>
+  <NumeroLinea>{{ line_number }}</NumeroLinea>
+  <Detalle>{{ item.description }}</Detalle>
+  <MontoTotal>{{ (item.total_amount|default(0))|number_format(5, '.', '') }}</MontoTotal>
+  <SubTotal>{{ (item.sub_total|default(0))|number_format(5, '.', '') }}</SubTotal>
+  {% if item.taxes and item.taxes|length > 0 %}
+  {% include 'Components/taxes.xml.twig' with { 'node': 'Impuesto',
+  'nodeAmount': 'Monto', 'taxes': item.taxes } only %}
+  {% endif %}
+  <ImpuestoNeto>{{ (item.total_tax|default(0))|number_format(5, '.', '') }}</ImpuestoNeto>
+  <MontoTotalLinea>{{ (item.total|default(0))|number_format(5, '.', '') }}</MontoTotalLinea>
+</LineaDetalle>
diff --git a/src/Views/Components/summary-payment-receipt.xml.twig b/src/Views/Components/summary-payment-receipt.xml.twig
new file mode 100644
index 000000000..s10repsum
--- /dev/null
+++ b/src/Views/Components/summary-payment-receipt.xml.twig
@@ -0,0 +1,20 @@
+{# XSD reciboElectronicoPago v4.4: sin TotalServ*/TotalMerc*/TotalGravado/TotalDescuentos (condición 4). Tras moneda va TotalVenta. #}
+<ResumenFactura>
+  <CodigoTipoMoneda>
+    <CodigoMoneda>{{ currency.currency_code }}</CodigoMoneda>
+    <TipoCambio>{{ (currency.exchange_rate|default(1))|number_format(5, '.', '') }}</TipoCambio>
+  </CodigoTipoMoneda>
+  <TotalVenta>{{ (summary.total_sale|default(0))|number_format(2, '.', '') }}</TotalVenta>
+  <TotalVentaNeta>{{ (summary.total_net_sale|default(0))|number_format(2, '.', '') }}</TotalVentaNeta>
+  {% if summary.taxes and summary.taxes|length > 0 %}
+  {% include 'Components/taxes.xml.twig' with {
+    'node': 'TotalDesgloseImpuesto',
+    'nodeAmount': 'TotalMontoImpuesto',
+    'taxes': summary.taxes,
+    'fe_cr_es_total_desglose': true
+  } only %}
+  <TotalImpuesto>{{ (summary.total_tax|default(0))|number_format(2, '.', '') }}</TotalImpuesto>
+  {% endif %}
+  {% include 'Components/payments.xml.twig' %}
+  <TotalComprobante>{{ (summary.total_voucher|default(0))|number_format(2, '.', '') }}</TotalComprobante>
+</ResumenFactura>
