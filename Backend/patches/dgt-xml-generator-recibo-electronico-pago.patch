diff --git a/src/Models/PaymentReceipt/PaymentReceipt.php b/src/Models/PaymentReceipt/PaymentReceipt.php
new file mode 100644
index 000000000..p10model1
--- /dev/null
+++ b/src/Models/PaymentReceipt/PaymentReceipt.php
@@ -0,0 +1,25 @@
+<?php
+
+namespace DazzaDev\DgtXmlGenerator\Models\PaymentReceipt;
+
+use DazzaDev\DgtXmlGenerator\Models\Document;
+
+/**
+ * Recibo electrónico de pago (tipo comprobante 10).
+ */
+class PaymentReceipt extends Document
+{
+    public function __construct(array $data = [])
+    {
+        $this->setDocumentType('10');
+
+        if (empty($data)) {
+            parent::__construct($data);
+        }
+    }
+
+    public function toArray(): array
+    {
+        return parent::toArray();
+    }
+}
