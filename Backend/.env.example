APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# CORS: vacío = usa config/cors.php (app unificado + localhost:4200 + patrones *.smartpyme.site).
# * = permitir cualquier origen. Lista: https://a.com,https://b.com
# CORS_ALLOWED_ORIGINS=
# CORS_SUPPORTS_CREDENTIALS=false

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# sync = jobs se ejecutan en el request (bloqueante). Para reportes async usar database o redis + queue:work
QUEUE_CONNECTION=database
# Restaurante Fase 5: side-effects no críticos (ticket cache + log/notif) post-commit.
# RESTAURANTE_SIDE_EFFECTS_ENABLED=true
# RESTAURANTE_SIDE_EFFECTS_QUEUE=default
# RESTAURANTE_TICKET_CACHE_TTL=300
# Restaurante Fase 6 realtime (opcional). Sin Reverb: BROADCAST_DRIVER=null y FE enabled=false.
# RESTAURANTE_REALTIME_ENABLED=true
# BROADCAST_DRIVER=null
# Para Reverb (opcional): composer require laravel/reverb && php artisan reverb:install
# BROADCAST_DRIVER=reverb
# REVERB_APP_ID=smartpyme
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=

# Lucas (servicio de IA en Python)
LUCAS_API_URL=http://localhost:8000
LUCAS_API_KEY=
LUCAS_API_TIMEOUT=120

DTE_S3_DISK=s3
DTE_S3_PRESIGNED_MINUTES=30
DTE_S3_SCHEDULE_ENABLED=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Windows / FE Costa Rica: ruta al openssl.exe si PHP (Apache, etc.) no ve el PATH del sistema
# OPENSSL_BIN="C:\Program Files\OpenSSL-Win64\bin\openssl.exe"

# Opcional: API pública Hacienda CR (proxy CAT/CABYS). Por defecto se usa https://api.hacienda.go.cr y TTL en config/services.php
# Si Hacienda devuelve HTML de bloqueo, probar User-Agent tipo navegador (ver default en config/services.php)
# HACIENDA_CR_USER_AGENT=Mozilla/5.0 ...
# HACIENDA_CR_API_BASE_URL=https://api.hacienda.go.cr
# HACIENDA_CR_CACHE_CABYS_CODIGO=21600
# HACIENDA_CR_CACHE_CABYS_Q=3600
# HACIENDA_CR_CACHE_CONTRIBUYENTE=43200

# SFTP — certificados FE hacia EC2 (El Salvador / firmador). La llave .pem en el servidor Laravel: chmod 600
EC2_HOST=
EC2_USER=ec2-user
EC2_KEY_PATH=/ruta/a/mi-llave.pem
EC2_UPLOADS_PATH=/home/uploads

# Gmail OAuth (for DTE module - download DTEs from email)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=

DTE_FRONTEND_URL=

# Cliente HTTP hacia Ministerio de Hacienda (DTE El Salvador)
MH_HTTP_TIMEOUT=120
MH_HTTP_CONNECT_TIMEOUT=30
MH_VERIFY_SSL=true

# Boxful API Integration
BOXFUL_ENV=development

# BCCR — tipo de cambio venta (indicador 318). Token JWT: https://sdd.bccr.fi.cr/es/IndicadoresEconomicos/Inicio/
BCCR_SDDE_URL=https://apim.bccr.fi.cr/SDDE/api/Bccr.Ge.SDDE.Publico.Indicadores.API
BCCR_WS_URL=https://gee.bccr.fi.cr/Indicadores/Suscripciones/WS/wsindicadoreseconomicos.asmx
BCCR_WS_EMAIL=
BCCR_WS_TOKEN=
BCCR_WS_NAME=SmartPyme
BCCR_WS_TIMEOUT=25
