# Copiar a Backend/.env.docker. Nunca poner aquí claves de producción:
# usar credenciales de prueba (sandbox de Hacienda/MH, S3 de pruebas, correo de prueba).
APP_NAME=SmartPyme
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8081
LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=smartpyme_prod
DB_USERNAME=smartpyme
DB_PASSWORD=smartpyme

# Igual que producción: Redis solo para la cola, vía predis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_DRIVER=file
SESSION_DRIVER=file
BROADCAST_DRIVER=log

# Correo: en local se recomienda MAIL_MAILER=log para no enviar correos reales
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@smartpyme.local
MAIL_FROM_NAME=SmartPyme
MAIL_TO_ADDRESS=dev@smartpyme.local

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4200

# Resto de variables: ver Backend/.env.example y pedir los valores de prueba al líder técnico.
